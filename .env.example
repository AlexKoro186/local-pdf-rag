# Ollama
OLLAMA_HOST=http://localhost:11434
RAG_CHAT_MODEL=gemma3:4b
RAG_EMBEDDING_MODEL=embeddinggemma

# Storage
RAG_PDF_DIR=data/pdfs
RAG_CHROMA_PATH=chroma_db
RAG_COLLECTION_NAME=pdf_knowledge_base

# Retrieval and ingestion
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.20
RAG_MAX_FILE_SIZE_MB=50
